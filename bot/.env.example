# Gemini API: fact invention and script writing (text only; the voice is Edge TTS)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cloudflare Workers AI: beat illustrations via Flux (free daily neurons)
# https://developers.cloudflare.com/workers-ai/models/flux-1-schnell/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# YouTube Data API v3. Run `python bot/get_youtube_refresh_token.py` once to get these.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# Scheduling: uploads go up private and auto-publish at PUBLISH_HOUR:00 in
# PUBLISH_TIMEZONE, at least REVIEW_WINDOW_HOURS after upload.
PUBLISH_TIMEZONE=America/New_York
PUBLISH_HOUR=12
REVIEW_WINDOW_HOURS=6

# Voice: free Edge TTS (Microsoft neural voices, no API key)
EDGE_TTS_VOICE=en-US-AndrewNeural
EDGE_TTS_RATE=+18%
EDGE_TTS_PITCH=+0Hz

# Upload automatically after generating (the CLI flag --post does the same)
AUTO_POST=false
