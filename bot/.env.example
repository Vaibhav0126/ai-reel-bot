# Gemini API — smarter scripts (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Cloudflare Workers AI — fact cartoons via Flux Schnell (free daily neurons)
# https://developers.cloudflare.com/workers-ai/models/flux-1-schnell/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Instagram Graph API (Business/Creator account linked to a Facebook Page)
# https://developers.facebook.com/
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# YouTube Data API v3 — run `python bot/get_youtube_refresh_token.py` once to get these
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public

# AndrewNeural = warmer adult male. +18% keeps Shorts snappy; script [pause] marks add breaths.
EDGE_TTS_VOICE=en-US-AndrewNeural
EDGE_TTS_RATE=+18%
EDGE_TTS_PITCH=+0Hz

# Post automatically after generating (true/false)
AUTO_POST=false
