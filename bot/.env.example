# Gemini API — smarter scripts (https://aistudio.google.com/apikey)
# Meal plate photos use free Pollinations.ai (no key). Gemini image is optional fallback only.
GEMINI_API_KEY=

# Instagram Graph API (Business/Creator account linked to a Facebook Page)
# https://developers.facebook.com/
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=

# AnaNeural = Cartoon/Cute — better for Nib than adult voices like Andrew
EDGE_TTS_VOICE=en-US-AnaNeural
EDGE_TTS_RATE=+20%
EDGE_TTS_PITCH=+0Hz

# Post automatically after generating (true/false)
AUTO_POST=false
